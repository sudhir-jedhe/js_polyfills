# =============================================================================
# Shared env for all micro-frontends (Next.js Multi-Zones, single domain).
# Copy to `.env` at the repo root for local dev (Turborepo passes these through).
# On Vercel, set them per-project.
# =============================================================================

# --- Secrets (server-only; NOT prefixed NEXT_PUBLIC => never in browser) ------

# Signs the mock session cookie (HMAC). Same value in ALL zones so any zone can
# verify the cookie. DEMO ONLY — use a strong secret from a secret manager IRL.
SESSION_SECRET=dev-only-insecure-secret-change-me

# --- Public origin ------------------------------------------------------------

# The ONE origin users visit (the shell). Used for absolute cross-zone redirects.
#   dev:  http://localhost:3000   prod: https://<your-shell-domain>
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Zone upstreams (ONLY needed by the shell/host for its rewrites) ----------
# Where the shell proxies each path prefix. Server-side only.
#   dev:  the local ports below
#   prod: each zone's own Vercel deployment URL, e.g. https://mfe-auth.vercel.app
AUTH_ZONE_URL=http://localhost:3001
DASHBOARD_ZONE_URL=http://localhost:3002
SETTINGS_ZONE_URL=http://localhost:3003

# --- Cookie domain (leave EMPTY for single-domain composition) ----------------
# Only set (".example.com") if you switch to the subdomain alternative.
COOKIE_DOMAIN=
