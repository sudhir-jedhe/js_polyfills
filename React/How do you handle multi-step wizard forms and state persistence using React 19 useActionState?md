Handling multi-step wizard forms with React 19’s `useActionState` involves managing accumulated step data, validating inputs per step, and tracking the active step index within the action's returned state.

You can persist the in-progress wizard state either via **Server Action State Accumulation** (passing accumulated fields via hidden inputs) or **Browser Storage Synchronization** (`sessionStorage`/`localStorage`).

---

### 1. Wizard State Schema and Server Action

Define a state type that holds the active step, all accumulated form values, and step-specific validation errors:

```typescript
// app/actions/wizard.ts
'use server';

import { z } from 'zod';

export interface WizardState {
  currentStep: number;
  data: {
    // Step 1: Account
    fullName?: string;
    email?: string;
    // Step 2: Shipping
    address?: string;
    city?: string;
    zipCode?: string;
  };
  errors?: Record<string, string[]>;
  isCompleted?: boolean;
}

const Step1Schema = z.object({
  fullName: z.string().min(2, 'Name must be at least 2 characters'),
  email: z.string().email('Invalid email address'),
});

const Step2Schema = z.object({
  address: z.string().min(5, 'Address is too short'),
  city: z.string().min(2, 'City is required'),
  zipCode: z.string().regex(/^\d{5,6}$/, 'Must be a valid zip code'),
});

export async function wizardAction(
  prevState: WizardState,
  formData: FormData
): Promise<WizardState> {
  const intent = formData.get('intent') as 'next' | 'back' | 'submit';

  // Handle navigating backwards without validation
  if (intent === 'back') {
    return {
      ...prevState,
      currentStep: Math.max(1, prevState.currentStep - 1),
      errors: undefined,
    };
  }

  // Handle Step 1: Account Info
  if (prevState.currentStep === 1) {
    const rawData = {
      fullName: formData.get('fullName') as string,
      email: formData.get('email') as string,
    };

    const parsed = Step1Schema.safeParse(rawData);
    if (!parsed.success) {
      return {
        ...prevState,
        errors: parsed.error.flatten().fieldErrors,
      };
    }

    return {
      currentStep: 2,
      data: { ...prevState.data, ...parsed.data },
      errors: undefined,
    };
  }

  // Handle Step 2: Shipping & Final Submission
  if (prevState.currentStep === 2) {
    const rawData = {
      address: formData.get('address') as string,
      city: formData.get('city') as string,
      zipCode: formData.get('zipCode') as string,
    };

    const parsed = Step2Schema.safeParse(rawData);
    if (!parsed.success) {
      return {
        ...prevState,
        errors: parsed.error.flatten().fieldErrors,
      };
    }

    const finalPayload = { ...prevState.data, ...parsed.data };

    // Execute final DB / order creation
    await db.order.create({ data: finalPayload });

    return {
      currentStep: 3,
      data: finalPayload,
      isCompleted: true,
      errors: undefined,
    };
  }

  return prevState;
}

```

